<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Aesthetic Playlist</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #121212, #1f1c2c);
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .player-container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 30px;
            border-radius: 20px;
            width: 100%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }
        .thumbnail {
            width: 100%;
            height: 220px;
            background: linear-gradient(to bottom, #fc466b, #3f5efb);
            border-radius: 15px;
            margin-bottom: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 60px;
        }
        h2 { font-size: 24px; margin-bottom: 5px; }
        p.artist { color: #b3b3b3; font-size: 14px; margin-bottom: 25px; }
        .controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 25px;
            margin-bottom: 20px;
        }
        .btn { background: none; border: none; color: white; font-size: 28px; cursor: pointer; }
        .play-btn {
            font-size: 35px;
            background: #ffffff;
            color: #121212;
            width: 65px;
            height: 65px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .lyrics-section {
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            font-style: italic;
            color: #e0e0e0;
        }
    </style>
</head>
<body>

    <div class="player-container">
        <div class="thumbnail">🎵</div>
        <h2>Tu Hai Kahan</h2>
        <p class="artist">Lo-fi Vibes x Emotional</p>
        <div class="controls">
            <button class="btn">⏮</button>
            <button class="btn play-btn" onclick="togglePlay()">▶</button>
            <button class="btn">⏭</button>
        </div>
        <div class="lyrics-section">
            <p>"Tu hai kahan... khwaabon ke is jahan mein..."</p>
        </div>
    </div>

    <script>
        let isPlaying = false;
        function togglePlay() {
            const playBtn = document.querySelector('.play-btn');
            isPlaying = !isPlaying;
            if(isPlaying) {
                playBtn.innerText = "⏸";
            } else {
                playBtn.innerText = "▶";
            }
        }
    </script>

</body>
</html>

